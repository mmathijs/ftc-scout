schema: "http://localhost:4005/graphql" # must match PORT in packages/server/.env
documents: "./src/lib/graphql/**/*.graphql"
generates:
    ./src/lib/graphql/generated/graphql-operations.ts:
        plugins:
            - typescript
            - typescript-operations
            - typed-document-node
        config:
          useTypeImports: true
    # ./src/lib/graphql/generated/schema.json:
    #     plugins:
    #         - introspection
